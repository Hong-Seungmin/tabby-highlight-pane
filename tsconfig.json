{
  "compilerOptions": {
    "module": "es2015",
    "moduleResolution": "node",
    "target": "es2016",
    "lib": ["es2016", "dom"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

